<?xml version="1.0" encoding="utf-8"?>
<!-- One app in the All apps grid: icon over its name, with a focus ring drawn on the tile. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:padding="8dp">

    <LinearLayout
        android:id="@+id/allAppsTile"
        android:layout_width="132dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="14dp"
        android:paddingBottom="10dp"
        android:background="@drawable/all_apps_tile"
        android:focusable="true"
        android:clickable="true"
        android:gravity="center_horizontal">

        <ImageView
            android:id="@+id/allAppsIcon"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:scaleType="fitCenter"
            android:contentDescription="@null" />

        <TextView
            android:id="@+id/allAppsLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:gravity="center"
            android:singleLine="true"
            android:ellipsize="end"
            android:textColor="#F2FFFFFF"
            android:textSize="13sp"
            android:fontFamily="@font/outfit" />
    </LinearLayout>

    <!-- The focus ring sits on the frame, not the tile: the tile is already busy with its own plate. -->
    <View
        android:id="@+id/allAppsRing"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/all_apps_focus"
        android:visibility="invisible" />

</FrameLayout>
