<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <!-- No background of its own: the window's is already black, and every full-screen paint costs
         a frame's worth of GPU fill on TV chips. -->

    <!-- Backdrop still for the focused dock app, darkened for legibility (baked in by Backdrops). -->
    <FrameLayout
        android:id="@+id/backdrop"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0">

        <!-- The previous still, under the new one while they cross-fade. -->
        <ImageView
            android:id="@+id/backdropPrevious"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:visibility="gone"
            android:contentDescription="@null" />

        <ImageView
            android:id="@+id/backdropImage"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:contentDescription="@null" />

        <!-- A film or show's title on its backdrop: the logo, or the name when there is none. Above the
             tint so it stays bright; lined up with the app name by MainActivity. -->
        <FrameLayout
            android:id="@+id/backdropTitleBox"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end|top"
            android:layout_marginEnd="50dp">

            <ImageView
                android:id="@+id/backdropLogo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end|bottom"
                android:maxWidth="340dp"
                android:maxHeight="110dp"
                android:adjustViewBounds="true"
                android:scaleType="fitEnd"
                android:visibility="gone"
                android:contentDescription="@null" />

            <TextView
                android:id="@+id/backdropTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end|bottom"
                android:gravity="end"
                android:maxWidth="420dp"
                android:maxLines="2"
                android:ellipsize="end"
                android:visibility="gone"
                android:textColor="#FFFFFFFF"
                android:textSize="34sp"
                android:fontFamily="@font/outfit"
                android:includeFontPadding="false"
                android:shadowColor="#99000000"
                android:shadowRadius="14" />
        </FrameLayout>
    </FrameLayout>

    <!-- Ambient glow in the colour of the focused dock app (apps without a backdrop). -->
    <View
        android:id="@+id/ambient"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0" />

    <!-- Top shelf: the focused dock app's name, positioned above the dock in code. -->
    <TextView
        android:id="@+id/heroName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="62dp"
        android:alpha="0"
        android:textColor="#FFFFFFFF"
        android:textSize="48sp"
        android:fontFamily="@font/outfit"
        android:letterSpacing="-0.02"
        android:includeFontPadding="false"
        android:singleLine="true" />

    <!-- The wrapper clips at its edge; the grid itself must not clip so scaled tiles can overflow their
         cells. The grid runs the full height so tiles scroll up under the top bar, which frosts them. -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginStart="50dp"
        android:layout_marginEnd="50dp">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/grid"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingTop="10dp"
            android:paddingBottom="40dp"
            android:clipToPadding="false"
            android:clipChildren="false"
            android:overScrollMode="never"
            android:scrollbars="none"
            android:descendantFocusability="afterDescendants" />
    </FrameLayout>

    <!-- Top bar over the grid, on a frosted copy of whatever has scrolled beneath it. -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <com.maydings.vibelauncher.FrostView
            android:id="@+id/frost"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no" />

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="50dp"
            android:layout_marginEnd="50dp"
            android:layout_marginTop="26dp"
            android:layout_marginBottom="10dp">

            <LinearLayout
                android:id="@+id/leftBlock"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_toStartOf="@+id/topButtons"
                android:layout_marginEnd="16dp"
                android:orientation="vertical">

                <!-- Hidden until the TV knows the time (MainActivity). -->
                <LinearLayout
                    android:id="@+id/clockRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:baselineAligned="false">
                    <!-- Pinned to the bottom, not to the clock's baseline, so a two-line date grows upwards
                         without lifting AM with it. -->

                    <!-- The time and AM/PM, as wide as the widest time with as many hour digits, so the date
                         doesn't shift from 1:40 to 1:41: the digits differ in width (sized in MainActivity). -->
                    <LinearLayout
                        android:id="@+id/timeBox"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:baselineAligned="false">

                        <TextClock
                            android:id="@+id/clock"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:format12Hour="HH:mm"
                            android:format24Hour="HH:mm"
                            android:textColor="#FFFFFFFF"
                            android:textSize="52sp"
                            android:fontFamily="@font/outfit"
                            android:letterSpacing="-0.04"
                            android:includeFontPadding="false" />

                        <TextClock
                            android:id="@+id/ampm"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:layout_gravity="bottom"
                            android:layout_marginBottom="16.5dp"
                            android:format12Hour="a"
                            android:format24Hour=""
                            android:textColor="#B3FFFFFF"
                            android:textSize="15sp"
                            android:fontFamily="@font/outfit"
                            android:letterSpacing="0.08"
                            android:textAllCaps="true" />
                    </LinearLayout>

                    <!-- A long date (other languages) wraps onto a second line, growing upwards, instead of
                         running into the pills: the clock block ends where they begin. -->
                    <TextClock
                        android:id="@+id/date"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="20dp"
                        android:layout_gravity="bottom"
                        android:layout_marginBottom="17.5dp"
                        android:maxLines="2"
                        android:ellipsize="end"
                        android:format12Hour="EEEE  d MMMM yyyy"
                        android:format24Hour="EEEE  d MMMM yyyy"
                        android:textColor="#A6FFFFFF"
                        android:textSize="14sp"
                        android:fontFamily="@font/outfit"
                        android:letterSpacing="0.14"
                        android:textAllCaps="true" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/topButtons"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_alignBottom="@id/leftBlock"
                android:layout_marginBottom="16dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btnInputs"
                    style="@style/TopButton"
                    android:text="@string/inputs"
                    android:drawableStart="@drawable/ic_input"
                    android:nextFocusDown="@+id/grid" />

                <TextView
                    android:id="@+id/btnWifi"
                    style="@style/TopButton"
                    android:layout_height="30dp"
                    android:textSize="12sp"
                    android:paddingStart="11dp"
                    android:paddingEnd="13dp"
                    android:drawablePadding="6dp"
                    android:text="@string/wifi"
                    android:drawableStart="@drawable/ic_wifi_top"
                    android:background="@drawable/pill_bg_top"
                    android:nextFocusDown="@+id/grid" />

                <!-- A green dot in the gear's hollow centre while an update is ready (MainActivity.showUpdateReady).
                     Placed from the start: TopButton's 10dp margin and 16dp padding put the 22dp gear's centre
                     37dp across and 21dp down. -->
                <FrameLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">

                    <TextView
                        android:id="@+id/btnSettings"
                        style="@style/TopButton"
                        android:layout_height="30dp"
                        android:textSize="12sp"
                        android:paddingStart="11dp"
                        android:paddingEnd="13dp"
                        android:drawablePadding="6dp"
                        android:text="@string/settings"
                        android:drawableStart="@drawable/ic_settings_top"
                        android:background="@drawable/pill_bg_top"
                        android:nextFocusDown="@+id/grid" />

                    <!-- Dot offsets track the smaller pill: 30/42 of the original 34.5/18.5. -->
                    <View
                        android:id="@+id/updateDot"
                        android:layout_width="5dp"
                        android:layout_height="5dp"
                        android:layout_gravity="top|start"
                        android:layout_marginTop="13dp"
                        android:layout_marginStart="25dp"
                        android:background="@drawable/status_dot"
                        android:visibility="gone" />
                </FrameLayout>
            </LinearLayout>
        </RelativeLayout>
    </FrameLayout>

    <!-- The single floating glass highlight that springs between tiles. -->
    <com.maydings.vibelauncher.GlassView
        android:id="@+id/glass"
        android:layout_width="10dp"
        android:layout_height="10dp"
        android:alpha="0"
        android:importantForAccessibility="no" />
</FrameLayout>
