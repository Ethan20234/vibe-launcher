<?xml version="1.0" encoding="utf-8"?>
<!-- Vibe Launcher settings on two tabs: General (tiles per row, updates) and API keys (the backdrop
     sources' keys and the phone QR code). Save and Cancel on the right serve both. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="620dp"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/glass_panel"
    android:padding="28dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/vibe_settings"
        android:textColor="#FFFFFFFF"
        android:textSize="22sp"
        android:fontFamily="@font/outfit" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tabGeneral"
            style="@style/TopButton"
            android:layout_marginStart="0dp"
            android:text="@string/tab_general" />

        <TextView
            android:id="@+id/tabKeys"
            style="@style/TopButton"
            android:text="@string/tab_keys" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <!-- Both pages in one frame; only the chosen tab's page is there (SettingsDialog). -->
        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">

            <LinearLayout
                android:id="@+id/pageGeneral"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Label and choices on one line, so the dialog still fits a 1080p screen. Each label has a
                     maxWidth: a long translation wraps onto two lines instead of pushing its choices off the
                     column's edge (about 332dp wide). -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        style="@style/SettingsLabel"
                        android:layout_marginTop="0dp"
                        android:layout_marginEnd="6dp"
                        android:maxWidth="130dp"
                        android:text="@string/tiles_per_row" />

                    <TextView
                        android:id="@+id/columns4"
                        style="@style/TopButton"
                        android:paddingStart="22dp"
                        android:paddingEnd="22dp"
                        android:text="4" />

                    <TextView
                        android:id="@+id/columns5"
                        style="@style/TopButton"
                        android:paddingStart="22dp"
                        android:paddingEnd="22dp"
                        android:text="5" />

                    <TextView
                        android:id="@+id/columns6"
                        style="@style/TopButton"
                        android:paddingStart="22dp"
                        android:paddingEnd="22dp"
                        android:text="6" />
                </LinearLayout>

                <!-- Off or on, the choice marked like tiles per row; applied on Save. -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        style="@style/SettingsLabel"
                        android:layout_marginTop="0dp"
                        android:layout_marginEnd="6dp"
                        android:maxWidth="150dp"
                        android:text="@string/hide_inactive_inputs" />

                    <TextView
                        android:id="@+id/hideInputsOff"
                        style="@style/TopButton"
                        android:paddingStart="20dp"
                        android:text="@string/off" />

                    <TextView
                        android:id="@+id/hideInputsOn"
                        style="@style/TopButton"
                        android:paddingStart="20dp"
                        android:text="@string/on" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        style="@style/SettingsLabel"
                        android:layout_marginTop="0dp"
                        android:layout_marginEnd="6dp"
                        android:maxWidth="150dp"
                        android:text="@string/language" />

                    <!-- The language in use; opens the list (SettingsDialog), applied on Save. -->
                    <TextView
                        android:id="@+id/languageButton"
                        style="@style/TopButton"
                        android:paddingStart="20dp" />
                </LinearLayout>

                <!-- App lock: the PIN that guards locked tiles. Shows Change once one is set, Set when not;
                     applied at once, not on Save (a PIN change is its own dialog). -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        style="@style/SettingsLabel"
                        android:layout_marginTop="0dp"
                        android:layout_marginEnd="6dp"
                        android:maxWidth="150dp"
                        android:text="@string/app_lock_pin" />

                    <TextView
                        android:id="@+id/pinButton"
                        style="@style/TopButton"
                        android:paddingStart="20dp" />
                </LinearLayout>

                <TextView
                    style="@style/SettingsLabel"
                    android:layout_marginTop="28dp"
                    android:text="@string/updates" />

                <TextView
                    android:id="@+id/updateStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:textColor="#B3FFFFFF"
                    android:textSize="15sp"
                    android:fontFamily="@font/outfit" />

                <TextView
                    android:id="@+id/updateButton"
                    style="@style/TopButton"
                    android:layout_marginStart="0dp"
                    android:layout_marginTop="12dp"
                    android:paddingStart="20dp"
                    android:text="@string/check_updates" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/pageKeys"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <LinearLayout style="@style/SettingsLabelRow">

                    <TextView
                        style="@style/SettingsLabel"
                        android:layout_marginTop="0dp"
                        android:text="@string/tmdb_key" />

                    <ImageView
                        android:id="@+id/tmdbInfo"
                        style="@style/InfoButton" />
                </LinearLayout>

                <EditText
                    android:id="@+id/tmdbKey"
                    style="@style/SettingsField" />

                <LinearLayout style="@style/SettingsLabelRow">

                    <TextView
                        style="@style/SettingsLabel"
                        android:layout_marginTop="0dp"
                        android:text="@string/youtube_key" />

                    <ImageView
                        android:id="@+id/youtubeInfo"
                        style="@style/InfoButton" />
                </LinearLayout>

                <!-- SmartTube signed in beats a key (the user's own feed): offered first, Install or Open. -->
                <TextView
                    android:id="@+id/smartTubeButton"
                    style="@style/TopButton"
                    android:layout_marginStart="0dp"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="4dp"
                    android:paddingStart="20dp" />

                <EditText
                    android:id="@+id/youtubeKey"
                    style="@style/SettingsField" />

                <LinearLayout style="@style/SettingsLabelRow">

                    <TextView
                        style="@style/SettingsLabel"
                        android:layout_marginTop="0dp"
                        android:text="@string/plex_token" />

                    <ImageView
                        android:id="@+id/plexInfo"
                        style="@style/InfoButton" />
                </LinearLayout>

                <EditText
                    android:id="@+id/plexToken"
                    style="@style/SettingsField"
                    android:imeOptions="actionDone|flagNoExtractUi" />

                <!-- TMDB's terms ask apps using its API to say so. -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="@string/tmdb_notice"
                    android:textColor="#66FFFFFF"
                    android:textSize="11sp"
                    android:fontFamily="@font/outfit" />
            </LinearLayout>
        </FrameLayout>

        <!-- Right of everything on the left, so Right from any row reaches Save and Cancel. -->
        <LinearLayout
            android:layout_width="200dp"
            android:layout_height="match_parent"
            android:layout_marginStart="32dp"
            android:layout_marginTop="20dp"
            android:orientation="vertical"
            android:gravity="center_horizontal">

            <!-- Save and Cancel first, so they sit in the same place on both tabs; the QR code comes under
                 them on API keys only. -->
            <TextView
                android:id="@+id/save"
                style="@style/TopButton"
                android:layout_width="match_parent"
                android:layout_marginStart="0dp"
                android:layout_marginTop="0dp"
                android:paddingStart="20dp"
                android:text="@string/save" />

            <TextView
                android:id="@+id/cancel"
                style="@style/TopButton"
                android:layout_width="match_parent"
                android:layout_marginStart="0dp"
                android:layout_marginTop="12dp"
                android:paddingStart="20dp"
                android:text="@string/cancel" />

            <!-- Scan to type the keys on a phone instead (PhoneLink). -->
            <LinearLayout
                android:id="@+id/phone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:visibility="gone">

                <ImageView
                    android:id="@+id/qr"
                    android:layout_width="130dp"
                    android:layout_height="130dp"
                    android:padding="8dp"
                    android:background="#FFFFFFFF"
                    android:contentDescription="@null" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center"
                    android:text="@string/scan_to_paste"
                    android:textColor="#B3FFFFFF"
                    android:textSize="13sp"
                    android:fontFamily="@font/outfit" />

                <TextView
                    android:id="@+id/phoneUrl"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="center"
                    android:textColor="#80FFFFFF"
                    android:textSize="11sp"
                    android:fontFamily="@font/outfit" />
            </LinearLayout>

            <!-- The project's home, bottom right of General (SettingsDialog). Plain text: TVs rarely have a
                 browser to open it in. -->
            <Space
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/projectLink"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:text="@string/project_link"
                android:textColor="#80FFFFFF"
                android:textSize="12sp"
                android:fontFamily="@font/outfit" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
